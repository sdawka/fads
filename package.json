{
  "name": "fads",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "typecheck": "astro check && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && vitest run --config vitest.workers.config.ts",
    "test:unit": "vitest run test/unit test/site/demo-edition.test.ts",
    "test:real-worker": "npm run build && vitest run --config vitest.real-worker.config.ts",
    "test:typecheck": "tsc -p test/tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "cf-typegen": "wrangler types src/worker-configuration.d.ts",
    "dev:site": "astro dev --config astro.site.config.ts",
    "build:site": "astro build --config astro.site.config.ts",
    "preview:site": "astro preview --config astro.site.config.ts",
    "test:site": "playwright test --config playwright.site.config.ts",
    "setup:key": "node scripts/generate-oauth-key.mjs",
    "setup:check": "node scripts/check-install.mjs",
    "build:install": "FADS_WRANGLER_CONFIG=wrangler.install.jsonc astro build",
    "deploy:install": "npm run setup:check && npm run build:install && wrangler d1 migrations apply DB --remote --config wrangler.install.jsonc && wrangler deploy --config dist/server/wrangler.json",
    "deploy:site": "npm run build:site && wrangler deploy --config wrangler.site.jsonc"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.5",
    "@astrojs/svelte": "^9.0.1",
    "@atcute/bluesky": "^4.0.20",
    "@atcute/client": "^5.1.1",
    "@atcute/identity-resolver": "^2.0.1",
    "@atcute/oauth-node-client": "^2.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@lucide/svelte": "^1.43.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "bits-ui": "^2.19.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.1",
    "htmlparser2": "^12.0.0",
    "ipaddr.js": "^2.5.0",
    "svelte": "^5.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@eslint/js": "^9.0.0",
    "@internationalized/date": "^3.12.4",
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.31.0",
    "fast-check": "^4.9.0",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.0.0",
    "svelte-check": "^4.7.6",
    "tailwind-variants": "^3.3.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
