---
import Demo from "../components/Demo.svelte";
import Explanation from "../components/Explanation.astro";
import "../../src/styles/ui.css";

const title = "f.ads — show me what's cool";
const description = "A self-hosted, finite reader for your ATProto and RSS sources.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#2643e9" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? Astro.url)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL("/social.svg", Astro.site ?? Astro.url)} />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <section class="hero" aria-labelledby="hero-title" data-motion-section>
        <svg class="hero-field" viewBox="0 0 1000 760" aria-hidden="true">
          <path class="field-orbit" d="M80 575C235 430 323 617 475 464S742 272 922 157" />
          <path class="field-shape field-shape-one" d="M742 74c86-41 188 34 146 120-36 73-158 73-190-4-20-48 3-92 44-116Z" />
          <path class="field-shape field-shape-two" d="M77 448c51-76 171-53 189 37 15 76-70 143-139 106-61-33-84-92-50-143Z" />
          <circle class="field-dot field-dot-one" cx="870" cy="535" r="25" />
          <circle class="field-dot field-dot-two" cx="348" cy="119" r="14" />
        </svg>
        <nav aria-label="Main navigation"><a class="wordmark" href="/">f.ads</a><span class="nav-links"><a href="https://github.com/sdawka/fads" rel="noopener noreferrer">GitHub</a><a href="/install/">Host your own</a></span></nav>
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="hero-kicker">show me what's cool</p>
            <h1 id="hero-title">Take back the interface.</h1>
            <p>They send structure. You decide the screen.</p>
            <div class="hero-actions"><a class="primary-link" href="#demo">Try an edition</a><a class="quiet-link" href="/install/">Host your own</a></div>
          </div>
          <div class="garden-tray" aria-label="A finite reading edition with three selected pieces">
            <p class="tray-title">Today’s small garden <span>3 pieces</span></p>
            <article class="tray-piece cobalt"><span>Field Notes</span><strong>A map that rewards lingering</strong><small>4 min</small></article>
            <article class="tray-piece lime"><span>Public Works</span><strong>The small library of useful paper</strong><small>6 min</small></article>
            <article class="tray-piece coral"><span>Signal Garden</span><strong>What opens after dark</strong><small>5 min</small></article>
            <p class="tray-end">You reached the end. Keep what matters.</p>
          </div>
        </div>
      </section>

      <section class="thesis" aria-labelledby="thesis-title" data-motion-section><div><p class="section-mark">A different contract</p><h2 id="thesis-title">Your feed is a garden, not a slot machine.</h2></div><p>f.ads is a reader you host for yourself. It collects from sources you choose, makes a short edition, and lets the edition finish. There is no engagement treadmill to keep you moving.</p></section>

      <Explanation />

      <Demo client:load />

      <section class="closing" data-motion-section>
        <svg class="closing-field" viewBox="0 0 1200 620" aria-hidden="true">
          <path d="M-30 476C224 241 390 638 650 333S1001 48 1244 158" />
          <circle cx="1046" cy="440" r="82" />
          <rect x="837" y="82" width="118" height="118" rx="18" />
        </svg>
        <div class="closing-copy"><p>f.ads / show me what’s cool</p><h2>Your sources. Your reader. Your pace.</h2><p class="hosting-note">Run your own copy on Cloudflare, then sign in with your ATProto account. Each installation is for one person.</p><a class="primary-link" href="/install/">Set up your reader</a></div>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing:border-box; } :global(html) { scroll-behavior:smooth; } :global(body) { margin:0; color:var(--foreground); font-family:var(--font-body); } :global(a) { color:inherit; }
  .hero { --pointer-x:0; --pointer-y:0; background:var(--background); min-height:47rem; overflow:hidden; padding:1.4rem max(1.25rem,calc((100vw - 76rem)/2)) 5rem; position:relative; } .hero > :not(.hero-field) { position:relative; z-index:1; } nav,.nav-links { align-items:center; display:flex; } nav { justify-content:space-between; } .nav-links { gap:1.25rem; } .nav-links a { font-size:.95rem; } .wordmark { font-family:var(--font-display,system-ui); font-size:1.65rem; font-weight:800; letter-spacing:-.08em; text-decoration:none; }
  .hero-field { height:100%; inset:0; pointer-events:none; position:absolute; width:100%; }.hero-field path,.hero-field circle { vector-effect:non-scaling-stroke; }.field-orbit { fill:none; opacity:.18; stroke:var(--primary); stroke-dasharray:7 18; stroke-width:2; transform:translate(calc(var(--pointer-x) * 4px),calc(var(--pointer-y) * 4px)); transition:transform var(--duration-responsive) var(--ease-out); }.field-shape { fill:var(--secondary); opacity:.72; stroke:var(--primary); stroke-width:2; transform-box:fill-box; transform-origin:center; transition:transform var(--duration-responsive) var(--ease-out); }.field-shape-one { transform:translate(calc(var(--pointer-x) * -9px),calc(var(--pointer-y) * -7px)) rotate(12deg); }.field-shape-two { fill:var(--lime); opacity:.35; transform:translate(calc(var(--pointer-x) * 7px),calc(var(--pointer-y) * 10px)) rotate(-8deg); }.field-dot { fill:var(--coral); opacity:.5; transition:transform var(--duration-responsive) var(--ease-out); }.field-dot-one { transform:translate(calc(var(--pointer-x) * 13px),calc(var(--pointer-y) * -11px)); }.field-dot-two { fill:var(--primary); transform:translate(calc(var(--pointer-x) * -6px),calc(var(--pointer-y) * 9px)); }
  .hero-grid { align-items:center; display:grid; gap:clamp(3rem,8vw,9rem); grid-template-columns:1fr minmax(19rem,.78fr); margin:clamp(4.5rem,10vw,9rem) auto 0; max-width:70rem; }.hero-kicker,.section-mark { color:var(--primary); font-weight:750; margin:0 0 1rem; }.hero h1,.thesis h2,.frame h2,.closing h2 { font-family:var(--font-display,system-ui); font-weight:800; letter-spacing:-.075em; line-height:.86; margin:0; }.hero h1 { font-size:clamp(4rem,9vw,8rem); max-width:7ch; }.hero-copy > p:not(.hero-kicker) { font-size:clamp(1.1rem,2vw,1.5rem); line-height:1.4; max-width:23ch; }.hero-actions { display:flex; flex-wrap:wrap; gap:1rem; margin-top:2rem; }.primary-link { background:var(--primary); border-radius:.45rem; color:oklch(1 0 0); display:inline-block; font-weight:700; padding:.9rem 1.1rem; text-decoration:none; }.quiet-link { font-weight:700; padding:.9rem 0; text-underline-offset:.25em; }
  .garden-tray { background:var(--card); border:2px solid var(--foreground); box-shadow:12px 12px 0 var(--lime); padding:1rem; transform:rotate(1.5deg); transform-origin:50% 100%; }.tray-title { display:flex; font-size:.82rem; font-weight:700; justify-content:space-between; margin:.2rem 0 1rem; }.tray-title span { color:var(--muted-foreground); }.tray-piece { color:var(--foreground); display:grid; gap:.35rem; margin:.65rem 0; padding:1rem; }.tray-piece span,.tray-piece small { font-size:.75rem; }.tray-piece strong { font-size:1.12rem; line-height:1.1; }.cobalt { background:oklch(0.887901 0.054623 275.009); }.lime { background:oklch(0.933164 0.133219 121.353); }.coral { background:oklch(0.870517 0.069476 29.532); }.tray-end { border-top:1px solid oklch(0.859188 0.011034 280.448); font-size:.8rem; margin:1rem 0 .1rem; padding-top:.8rem; }
  .thesis,.frame { display:grid; gap:3rem; grid-template-columns:1.15fr .85fr; margin:auto; max-width:76rem; padding:clamp(5rem,11vw,10rem) max(1.25rem,calc((100vw - 76rem)/2)); }.thesis { overflow:hidden; position:relative; }.thesis::after { background:var(--lime); content:""; height:.45rem; left:max(1.25rem,calc((100vw - 76rem)/2)); position:absolute; top:50%; transform:scaleX(0); transform-origin:left; width:min(19rem,45vw); }.thesis h2,.frame h2,.closing h2 { font-size:clamp(2.8rem,6vw,5.7rem); max-width:10ch; }.thesis > p,.frame > p { font-size:1.18rem; line-height:1.65; margin:3.3rem 0 0; max-width:31rem; }.frame { background:var(--secondary); max-width:none; padding-left:max(1.25rem,calc((100vw - 76rem)/2)); padding-right:max(1.25rem,calc((100vw - 76rem)/2)); }.frame .quiet-link { align-self:end; }
  .principles { border-block:1px solid var(--border); display:grid; grid-template-columns:repeat(3,1fr); }.principles article { min-height:20rem; padding:clamp(2rem,5vw,4rem); }.principles article + article { border-left:1px solid var(--border); }.principles span { color:var(--primary); font-weight:750; }.principles h2 { font-family:var(--font-display,system-ui); font-size:clamp(2rem,3vw,3rem); letter-spacing:-.06em; line-height:.92; }.principles p { color:var(--muted-foreground); line-height:1.55; max-width:27rem; }.closing { background:var(--primary); color:oklch(1 0 0); overflow:hidden; padding:clamp(4rem,10vw,9rem) max(1.25rem,calc((100vw - 76rem)/2)); position:relative; }.closing-copy { position:relative; z-index:1; }.closing-field { height:100%; inset:0; pointer-events:none; position:absolute; width:100%; }.closing-field path,.closing-field circle,.closing-field rect { fill:none; opacity:.28; stroke:var(--lime); stroke-width:3; transform-box:fill-box; transform-origin:center; vector-effect:non-scaling-stroke; }.closing p { font-weight:700; }.closing .hosting-note { font-weight:400; font-size:1.15rem; line-height:1.6; max-width:37rem; margin-top:2rem; }.closing h2 { font-size:clamp(3.5rem,8vw,7rem); max-width:11ch; }.closing .primary-link { background:var(--lime); color:var(--foreground); margin-top:2rem; transition:box-shadow var(--duration-fast) ease,transform var(--duration-fast) ease; }.closing .primary-link:hover,.closing .primary-link:focus-visible { box-shadow:7px 7px 0 var(--foreground); transform:translate(-3px,-3px); }
  :global(html[data-motion="ready"]) .hero-copy { animation:hero-copy-arrive var(--duration-scene) var(--ease-out) both; }:global(html[data-motion="ready"]) .garden-tray { animation:tray-settle 760ms var(--ease-spring) both; }:global(html[data-motion="ready"]) .tray-piece { animation:piece-slot 520ms var(--ease-out) both; }:global(html[data-motion="ready"]) .tray-piece:nth-of-type(2) { animation-delay:90ms; }:global(html[data-motion="ready"]) .tray-piece:nth-of-type(3) { animation-delay:180ms; }:global(html[data-motion="ready"]) .thesis[data-motion-state="visible"] h2 { animation:thesis-snap 680ms steps(4,end) both; }:global(html[data-motion="ready"]) .thesis[data-motion-state="visible"]::after { animation:thesis-rule 720ms var(--ease-out) both; }:global(html[data-motion="ready"]) .closing[data-motion-state="visible"] .closing-copy { animation:closing-release 820ms var(--ease-out) both; }:global(html[data-motion="ready"]) .closing[data-motion-state="visible"] .closing-field path { animation:closing-draw 1050ms var(--ease-out) both; }:global(html[data-motion="ready"]) .closing[data-motion-state="visible"] .closing-field circle { animation:closing-circle 720ms var(--ease-spring) 180ms both; }:global(html[data-motion="ready"]) .closing[data-motion-state="visible"] .closing-field rect { animation:closing-square 720ms var(--ease-spring) 300ms both; }
  @keyframes hero-copy-arrive { from { transform:translateY(1.6rem); } to { transform:none; } } @keyframes tray-settle { 0% { transform:translateY(-2.2rem) rotate(-4deg) scale(.96); } 68% { transform:translateY(.35rem) rotate(2.5deg) scale(1.01); } 100% { transform:rotate(1.5deg); } } @keyframes piece-slot { from { transform:translateX(1.5rem); } to { transform:none; } } @keyframes thesis-snap { 0% { transform:translateX(-1.4rem); } 100% { transform:none; } } @keyframes thesis-rule { 0% { transform:scaleX(0); } 42% { transform:scaleX(1); } 100% { transform:translateX(120%) scaleX(.2); } } @keyframes closing-release { from { transform:translateY(2.4rem); } to { transform:none; } } @keyframes closing-draw { from { stroke-dasharray:1400; stroke-dashoffset:1400; } to { stroke-dasharray:1400; stroke-dashoffset:0; } } @keyframes closing-circle { from { opacity:0; transform:scale(.3); } to { opacity:.28; transform:scale(1); } } @keyframes closing-square { from { opacity:0; transform:rotate(-25deg) scale(.45); } to { opacity:.28; transform:none; } }
  @media (max-width: 720px) { .hero { min-height:auto; }.hero-field { opacity:.55; transform:scale(1.3); }.hero-grid,.thesis,.frame { display:block; }.garden-tray { margin:3rem auto 0; max-width:27rem; }.thesis > p,.frame > p { margin-top:2rem; }.thesis::after { top:45%; }.principles { display:block; }.principles article + article { border-left:0; border-top:1px solid var(--border); }.frame .quiet-link { display:inline-block; margin-top:1rem; } } @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior:auto; }.hero-field,.closing-field { display:none; }.thesis::after { content:none; } }
</style>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const root = document.documentElement;
  const sections = document.querySelectorAll<HTMLElement>("[data-motion-section]");
  const hero = document.querySelector<HTMLElement>(".hero");
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
  let observer: IntersectionObserver | undefined;
  let pointerFrame = 0;

  const resetPointer = () => {
    if (!hero) return;
    hero.style.setProperty("--pointer-x", "0");
    hero.style.setProperty("--pointer-y", "0");
  };
  const movePointer = (event: PointerEvent) => {
    if (!hero || !finePointer.matches || root.dataset.motion !== "ready") return;
    cancelAnimationFrame(pointerFrame);
    pointerFrame = requestAnimationFrame(() => {
      const bounds = hero.getBoundingClientRect();
      const x = Math.max(-1, Math.min(1, ((event.clientX - bounds.left) / bounds.width - 0.5) * 2));
      const y = Math.max(-1, Math.min(1, ((event.clientY - bounds.top) / bounds.height - 0.5) * 2));
      hero.style.setProperty("--pointer-x", x.toFixed(3));
      hero.style.setProperty("--pointer-y", y.toFixed(3));
    });
  };
  const configureMotion = () => {
    observer?.disconnect();
    cancelAnimationFrame(pointerFrame);
    resetPointer();

    if (reduceMotion.matches) {
      root.dataset.motion = "reduced";
      return;
    }

    root.dataset.motion = "ready";
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          (entry.target as HTMLElement).dataset.motionState = "visible";
          observer?.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -12%", threshold: 0.12 },
    );
    sections.forEach((section) => {
      if (section.dataset.motionState !== "visible") observer?.observe(section);
    });
  };

  hero?.addEventListener("pointermove", movePointer, { passive: true });
  hero?.addEventListener("pointerleave", resetPointer);
  reduceMotion.addEventListener("change", configureMotion);
  configureMotion();

  const cleanup = () => {
    observer?.disconnect();
    cancelAnimationFrame(pointerFrame);
    hero?.removeEventListener("pointermove", movePointer);
    hero?.removeEventListener("pointerleave", resetPointer);
    reduceMotion.removeEventListener("change", configureMotion);
  };
  window.addEventListener("pagehide", cleanup, { once: true });
  document.addEventListener("astro:before-swap", cleanup, { once: true });
</script>
