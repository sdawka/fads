  .source { display:flex; align-items:center; gap:1.2rem; background:white; padding:1.6rem; border-radius:.6rem; }
  .source p { margin:.5rem 0 0; }
  .source svg { width:3rem; flex-shrink:0; color:var(--primary); fill:none; stroke:currentColor; stroke-width:2.5; }
  .connector { width:100%; fill:none; stroke:var(--primary); stroke-width:2; }
  .mobile-connector { display:none; fill:none; stroke:var(--primary); stroke-width:2; }
  .own-reader { background:var(--primary); color:white; padding:2rem; border-radius:.6rem; }
  .reader-name { font-family:var(--font-display); font-size:3rem; font-weight:800; letter-spacing:-.08em; }
  .own-reader > p { margin:0 0 1.5rem; }
  .mini-edition { display:grid; gap:.6rem; background:white; color:var(--foreground); padding:1.4rem; border-radius:.25rem; box-shadow:5px 5px 0 var(--lime); }
  .mini-edition strong { font-family:var(--font-display); font-size:1.7rem; line-height:1.15; }
  .mini-edition span { font-size:.85rem; }
  .map-caption { max-width:42rem; margin:2rem auto 0; text-align:center; }
  .atproto-note { border-top:1px solid #b9c3ee; margin-top:3rem; padding-top:2rem; display:grid; grid-template-columns:1fr 2fr; gap:2rem; }
  .atproto-note p { margin:0; max-width:45rem; }
  .steps { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:2.5rem; list-style:none; padding:0; margin:3.5rem 0; }
  .step-heading { display:flex; align-items:start; gap:.8rem; }
  .step-heading > span { display:grid; place-items:center; width:1.8rem; height:1.8rem; flex-shrink:0; background:var(--primary); color:white; border-radius:50%; font-size:.9rem; font-weight:700; }
  .steps li { display:flex; flex-direction:column; }
  .steps p { color:var(--muted-foreground); }
  .step-art { width:100%; max-width:23rem; margin-top:auto; }
  .step-art text { font:17px system-ui,sans-serif; fill:#151824; }
  .feedback-note { display:flex; align-items:start; gap:1.5rem; background:#f0f5e7; padding:2rem; border-radius:.5rem; }
  .feedback-note svg { flex-shrink:0; width:3rem; fill:none; stroke:var(--primary); stroke-width:3; }
  .feedback-note p { max-width:49rem; margin:.7rem 0 0; }
  @media(max-width:760px) { .source-map { grid-template-columns:1fr; max-width:30rem; margin-top:2rem; }.connector { display:none; }.mobile-connector { display:block; height:4rem; margin:auto; }.sources { gap:.7rem; }.source { padding:1.2rem; }.atproto-note { grid-template-columns:1fr; gap:1rem; }.steps { grid-template-columns:1fr; gap:2rem; }.steps li { border-top:1px solid var(--border); padding-top:1.5rem; }.step-art { margin:0 auto; }.feedback-note { padding:1.4rem; gap:1rem; }.feedback-note svg { width:2rem; } }
</style>
